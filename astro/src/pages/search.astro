---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const movies = (await getCollection('movies')).sort((a, b) =>
  a.data.title.localeCompare(b.data.title)
);

let actors: Awaited<ReturnType<typeof getCollection<'actors'>>> = [];
try {
  const result = await getCollection('actors');
  if (result) actors = result;
} catch {
  // No actor content files yet — collection is empty
}
---

<BaseLayout title="Search" bodyClass="bg_blue">
  <Header />

  <div class="center_content">
    <p id="search"></p>
    <h2 id="no_results">No Results</h2>

    <h1 id="search_actor_header">Actors</h1>
    <ul id="actors_list" aria-label="List of Actors generated by search">
      {actors.map((actor) => {
        const displayName = actor.data.display_name ?? actor.data.title
        return (

        <li data-movie-title={`${actor.data.title}`} class="inner_shadow">
          <a href={actor.data.permalink} aria-label={`Link to ${displayName} page`}>
            <div class="side_by_side">
              <img src={actor.data.thumbnail} class="circle_img" alt={`${displayName} Thumbnail`} height="80px">
              <p>{displayName}</p>
            </div>
          </a>
        </li>
        )
      }
      )}
    </ul>

    <h1 id="search_movie_header">Movies</h1>
    <ul id="movies_search_list" class="inner_shadow" aria-label="List of Movies generated by search">
      {movies.map((movie) => (
        <li
          data-year={movie.data.year}
          data-movie-title={movie.data.title}
          data-movie-cast={movie.data.cast.map((p) => p.name).join(', ')}
        >
          <a href={movie.data.permalink}>
            <div class="explore_movie_li" style={`background-image: url('${movie.data.thumbnail}')`} aria-label={`${movie.data.title} Thumbnail`}></div>
            <div>{movie.data.title}</div>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <Footer />

  <script is:inline>
    function filterActors(query) {
      var hasAtLeastOne = false;
      var filter = query.toUpperCase();
      var ul = document.getElementById("actors_list");
      if (!ul) return false;
      var li = ul.getElementsByTagName("li");
      for (var i = 0; i < li.length; i++) {
        var a = li[i].getAttribute("data-movie-title");
        if (a.toUpperCase().indexOf(filter) > -1) {
          li[i].style.display = "";
          hasAtLeastOne = true;
        } else {
          li[i].style.display = "none";
        }
      }

      if (hasAtLeastOne) {
        document.getElementById("search_actor_header").style.display = "";
      } else {
        document.getElementById("search_actor_header").style.display = "none";
      }
      return hasAtLeastOne;
    }

    function filterMovies(query) {
      var hasAtLeastOne = false;
      var filter = query.toUpperCase();
      var ul = document.getElementById("movies_search_list");
      if (!ul) return false;
      var li = ul.getElementsByTagName("li");
      for (var i = 0; i < li.length; i++) {
        var a = li[i].getAttribute("data-movie-title");
        if (a.toUpperCase().indexOf(filter) > -1) {
          li[i].style.display = "";
          hasAtLeastOne = true;
        } else {
          li[i].style.display = "none";
        }
      }

      for (var i = 0; i < li.length; i++) {
        var a = li[i].getAttribute("data-movie-cast");
        if (a.toUpperCase().indexOf(filter) > -1) {
          li[i].style.display = "";
          hasAtLeastOne = true;
        }
      }

      if (hasAtLeastOne) {
        document.getElementById("search_movie_header").style.display = "";
        document.getElementById("movies_search_list").style.display = "";
      } else {
        document.getElementById("search_movie_header").style.display = "none";
        document.getElementById("movies_search_list").style.display = "none";
      }

      return hasAtLeastOne;
    }

    function postIfNone(query, hasActor, hasMovie) {
      if (hasActor || hasMovie) {
        document.getElementById("no_results").style.display = "none";
      } else {
        document.getElementById("no_results").style.display = "";
      }
    }

    function getQueryVariable(variable) {
      var query = window.location.search.substring(1),
        vars = query.split("&");

      for (var i = 0; i < vars.length; i++) {
        var pair = vars[i].split("=");
        if (pair[0] === variable) {
          return decodeURIComponent(pair[1].replace(/\+/g, '%20')).trim();
        }
      }
    }

    var query = decodeURIComponent((getQueryVariable("q") || "").replace(/\+/g, "%20"));
    var hasActor = filterActors(query);
    var hasMovie = filterMovies(query);
    postIfNone(query, hasActor, hasMovie);
  </script>
</BaseLayout>
